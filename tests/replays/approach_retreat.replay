# Replay recording -- tests/replay/replay_file.h
#
# Generated by ds_replay_record. Do not hand-edit the hashes.
# When a deliberate balance or behavior change invalidates this file,
# re-record it IN THE SAME COMMIT as the change (AGENTS.md rule 8).
# A separate 'fix tests' commit destroys the signal that makes
# replays worth having.

